generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  nama        String           @unique
  deskripsi   String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime?        @updatedAt
  createdById Int?
  createdBy   User?            @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User?            @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  deletedById Int?
  deletedBy   User?            @relation("RoleDeletedBy", fields: [deletedById], references: [id])
  deletedAt   DateTime?
}

model RolePermission {
  id     Int     @id @default(autoincrement())
  roleId Int
  role   Role    @relation(fields: [roleId], references: [id])
  modul  String
  view   Boolean @default(true)
  create Boolean @default(false)
  edit   Boolean @default(false)
  delete Boolean @default(false)
  create_with_approval    Boolean @default(false)
  create_without_approval Boolean @default(false)

  @@unique([roleId, modul])
}

model User {
  id         Int           @id @default(autoincrement())
  username   String        @unique
  nama       String
  password   String
  roleId     Int
  role       Role          @relation(fields: [roleId], references: [id])
  status     String        @default("aktif")
  foto       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime?     @updatedAt
  updatedById Int?
  updatedBy  User?         @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  deletedById Int?
  deletedBy  User?         @relation("UserDeletedBy", fields: [deletedById], references: [id])
  deletedAt  DateTime?
  transaksi  Transaksi[]

  // Relations for audit on other tables
  sektorCreatedBy   Sektor[]  @relation("SektorCreatedBy")
  sektorUpdatedBy   Sektor[]  @relation("SektorUpdatedBy")
  sektorDeletedBy   Sektor[]  @relation("SektorDeletedBy")
  sahamCreatedBy    Saham[]   @relation("SahamCreatedBy")
  sahamUpdatedBy    Saham[]   @relation("SahamUpdatedBy")
  sahamDeletedBy    Saham[]   @relation("SahamDeletedBy")
  roleCreatedBy     Role[]    @relation("RoleCreatedBy")
  roleUpdatedBy     Role[]    @relation("RoleUpdatedBy")
  roleDeletedBy     Role[]    @relation("RoleDeletedBy")
  transaksiCreatedBy Transaksi[] @relation("TransaksiCreatedBy")
  transaksiUpdatedBy Transaksi[] @relation("TransaksiUpdatedBy")
  transaksiDeletedBy Transaksi[] @relation("TransaksiDeletedBy")
  approvalMatrixCreatedBy ApprovalMatrix[] @relation("ApprovalMatrixCreatedBy")
  approvalMatrixUpdatedBy ApprovalMatrix[] @relation("ApprovalMatrixUpdatedBy")
  approvalMatrixDeletedBy ApprovalMatrix[] @relation("ApprovalMatrixDeletedBy")
  approvalMatrixRecords   ApprovalMatrix[] @relation("ApprovalMatrixUser")
  approvalMatrixGroupCreatedBy ApprovalMatrixGroup[] @relation("ApprovalMatrixGroupCreatedBy")
  approvalMatrixGroupUpdatedBy ApprovalMatrixGroup[] @relation("ApprovalMatrixGroupUpdatedBy")
  approvalMatrixGroupDeletedBy ApprovalMatrixGroup[] @relation("ApprovalMatrixGroupDeletedBy")
  transaksiApprovalProcessed TransaksiApproval[] @relation("TransaksiApprovalProcessedBy")
  userUpdatedBy     User[]    @relation("UserUpdatedBy")
  userDeletedBy     User[]    @relation("UserDeletedBy")
}

model Sektor {
  id          Int         @id @default(autoincrement())
  kode        String      @unique
  nama        String
  deskripsi   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?   @updatedAt
  saham       Saham[]
  createdById Int?
  createdBy   User?       @relation("SektorCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User?       @relation("SektorUpdatedBy", fields: [updatedById], references: [id])
  deletedById Int?
  deletedBy   User?       @relation("SektorDeletedBy", fields: [deletedById], references: [id])
  deletedAt   DateTime?
}

model Saham {
  id                Int         @id @default(autoincrement())
  kode              String      @unique
  nama              String
  sektorId          Int
  sektor            Sektor      @relation(fields: [sektorId], references: [id])
  dividendPerShare  Float       @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime?   @updatedAt
  transaksi         Transaksi[]
  createdById       Int?
  createdBy         User?       @relation("SahamCreatedBy", fields: [createdById], references: [id])
  updatedById       Int?
  updatedBy         User?       @relation("SahamUpdatedBy", fields: [updatedById], references: [id])
  deletedById       Int?
  deletedBy         User?       @relation("SahamDeletedBy", fields: [deletedById], references: [id])
  deletedAt       DateTime?
}

model Transaksi {
  id          Int       @id @default(autoincrement())
  userId      Int
  sahamId     Int
  tipe        String
  jumlah      Int
  harga       Float
  tanggal     DateTime  @default(now())
  status      String    @default("approved")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  saham       Saham     @relation(fields: [sahamId], references: [id])
  approval    TransaksiApproval[]
  createdById Int?
  createdBy   User?     @relation("TransaksiCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User?     @relation("TransaksiUpdatedBy", fields: [updatedById], references: [id])
  deletedById Int?
  deletedBy   User?     @relation("TransaksiDeletedBy", fields: [deletedById], references: [id])
  deletedAt       DateTime?
  buktiPendukung  String?
  remarks         String?
}

model ApprovalMatrixGroup {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  nama        String
  status      String   @default("aktif")
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
  createdById Int?
  createdBy   User?    @relation("ApprovalMatrixGroupCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User?    @relation("ApprovalMatrixGroupUpdatedBy", fields: [updatedById], references: [id])
  deletedById Int?
  deletedBy   User?    @relation("ApprovalMatrixGroupDeletedBy", fields: [deletedById], references: [id])
  deletedAt   DateTime?

  items ApprovalMatrix[]
}

model ApprovalMatrix {
  id          Int      @id @default(autoincrement())
  groupId     Int
  group       ApprovalMatrixGroup @relation(fields: [groupId], references: [id])
  releaseLevel Int
  userId      Int
  user        User     @relation("ApprovalMatrixUser", fields: [userId], references: [id])
  tipe        String   @default("or")
  status      String   @default("aktif")
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
  createdById Int?
  createdBy   User?    @relation("ApprovalMatrixCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User?    @relation("ApprovalMatrixUpdatedBy", fields: [updatedById], references: [id])
  deletedById Int?
  deletedBy   User?    @relation("ApprovalMatrixDeletedBy", fields: [deletedById], references: [id])
  deletedAt   DateTime?

  @@unique([groupId, releaseLevel, userId])
}

model TransaksiApproval {
  id                 Int       @id @default(autoincrement())
  transaksiId        Int
  transaksi          Transaksi @relation(fields: [transaksiId], references: [id])
  releaseLevel       Int
  status             String    @default("pending")
  catatan            String?
  processedById      Int?
  processedBy        User?     @relation("TransaksiApprovalProcessedBy", fields: [processedById], references: [id])
  processedByUserIds Int[]     @default([])
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
}
